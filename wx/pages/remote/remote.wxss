.page-remote {
  min-height: 100vh;
  padding: 20rpx 22rpx 130rpx;
  box-sizing: border-box;
  background: transparent;
}

.hero {
  padding: 22rpx 20rpx;
  margin-bottom: 16rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.55);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(14rpx);
  box-shadow: 0 10rpx 30rpx rgba(84, 67, 44, 0.14);
}

.hero-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #102645;
  letter-spacing: 2rpx;
}

.hero-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #4d617f;
}

.hero-mode {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.hero-mode-text {
  font-size: 22rpx;
  color: #4d617f;
}

.mode-btn {
  margin: 0 !important;
  border-radius: 10rpx !important;
  background: rgba(246, 250, 255, 0.92) !important;
  border: 1rpx solid rgba(117, 147, 186, 0.35) !important;
  color: #29518a !important;
}

.hero-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 28rpx;
}

.pill {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.pill-on {
  background: rgba(52, 211, 153, 0.2);
  color: #6ee7b7;
  border: 1rpx solid rgba(52, 211, 153, 0.45);
}

.pill-off {
  background: rgba(248, 113, 113, 0.15);
  color: #fca5a5;
  border: 1rpx solid rgba(248, 113, 113, 0.35);
}

.pill-muted {
  background: rgba(255, 255, 255, 0.9);
  color: #4d617f;
  border: 1rpx solid rgba(117, 147, 186, 0.3);
}

.pill-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: currentColor;
  opacity: 0.9;
}

.card {
  background: rgba(255, 255, 255, 0.56);
  border-radius: 24rpx;
  padding: 24rpx 22rpx 28rpx;
  margin-bottom: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  box-shadow: 0 8rpx 26rpx rgba(83, 63, 36, 0.12);
  backdrop-filter: blur(14rpx);
}

.card-feed {
  padding-bottom: 20rpx;
}

.scene-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.scene-btn {
  border-radius: 14rpx !important;
  color: #fff !important;
  border: none !important;
}

.scene-home {
  background: linear-gradient(135deg, #0ea5e9, #2563eb) !important;
}

.scene-away {
  background: linear-gradient(135deg, #64748b, #334155) !important;
}

.card-hd {
  margin-bottom: 24rpx;
}

.card-hd-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.card-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
}

.card-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.4;
}

.sw-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.sw-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 20rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  border: 1rpx solid #e2e8f0;
}

.sw-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.sw-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #334155;
}

.sw-meta {
  font-size: 22rpx;
  color: #94a3b8;
}

.toggle {
  width: 96rpx;
  height: 52rpx;
  border-radius: 26rpx;
  background: #cbd5e1;
  position: relative;
  transition: background 0.2s ease;
}

.toggle-on {
  background: linear-gradient(135deg, #34d399, #10b981);
}

.toggle-knob {
  position: absolute;
  width: 44rpx;
  height: 44rpx;
  top: 4rpx;
  left: 4rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
  transition: left 0.2s ease;
}

.toggle-on .toggle-knob {
  left: 48rpx;
}

.step-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.step-cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 20rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  border: 1rpx solid #e2e8f0;
}

.step-label-col {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
  min-width: 0;
}

.step-label {
  font-size: 28rpx;
  color: #475569;
  font-weight: 500;
}

.step-temp {
  font-size: 36rpx;
  font-weight: 700;
  color: #0f172a;
  font-variant-numeric: tabular-nums;
}

.step-hint {
  font-size: 22rpx;
  color: #f97316;
  line-height: 1.35;
}

.step-btns {
  display: flex;
  gap: 16rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #0ea5e9, #2563eb) !important;
  color: #fff !important;
  border: none !important;
  border-radius: 12rpx !important;
  font-weight: 500;
}

.btn-ghost {
  background: #fff !important;
  color: #475569 !important;
  border: 1rpx solid #cbd5e1 !important;
  border-radius: 12rpx !important;
}

.btn-row {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 8rpx;
}

.btn-row .wide {
  width: 100% !important;
}

.field {
  margin-bottom: 20rpx;
}

.field-label {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 10rpx;
}

.field-input {
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx 22rpx;
  font-size: 26rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  color: #1e293b;
}

.hint-block {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  font-size: 24rpx;
  color: #64748b;
  background: #f1f5f9;
  border-radius: 12rpx;
  line-height: 1.5;
}

.hint-block.mono {
  font-family: ui-monospace, monospace;
  font-size: 22rpx;
  word-break: break-all;
}

.summary-line {
  font-size: 28rpx;
  color: #0f172a;
  font-weight: 500;
  padding: 16rpx 18rpx;
  margin-bottom: 16rpx;
  background: linear-gradient(90deg, #eff6ff, #f8fafc);
  border-radius: 14rpx;
  border-left: 6rpx solid #0ea5e9;
}

.feed-time-hd {
  font-size: 22rpx;
  color: #94a3b8;
  flex-shrink: 0;
  margin-top: 6rpx;
}

.feed-scroll {
  max-height: 420rpx;
  width: 100%;
}

.feed-item {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.feed-item:last-child {
  border-bottom: none;
}

.feed-ts {
  font-size: 22rpx;
  color: #94a3b8;
  width: 112rpx;
  flex-shrink: 0;
  font-variant-numeric: tabular-nums;
}

.feed-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.feed-sum {
  font-size: 26rpx;
  color: #334155;
  line-height: 1.45;
}

.feed-raw {
  font-size: 20rpx;
  color: #94a3b8;
  word-break: break-all;
}

.feed-empty {
  text-align: center;
  padding: 48rpx 24rpx;
  font-size: 26rpx;
  color: #94a3b8;
}

.adv-bar {
  padding: 20rpx 8rpx 28rpx;
}

.adv-bar-text {
  font-size: 26rpx;
  color: #475569;
  font-weight: 500;
}

.footer-space {
  height: 24rpx;
}
