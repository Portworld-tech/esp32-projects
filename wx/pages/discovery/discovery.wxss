/* 页面特有微调，主样式见 app.wxss */

.gw-box {
  padding: 18rpx 16rpx;
  border-radius: 14rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
}

.gw-name {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.gw-id {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
  word-break: break-all;
}

.gw-actions {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.gw-btn {
  margin: 0 !important;
}
