.mesh-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 20rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  border: 1rpx solid #e2e8f0;
}

.mesh-row-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}

.mesh-row-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #0f172a;
}

.mesh-row-sub {
  font-size: 24rpx;
  color: #64748b;
}

.mesh-toggle {
  width: 96rpx;
  height: 52rpx;
  border-radius: 26rpx;
  background: #cbd5e1;
  position: relative;
  flex-shrink: 0;
}

.mesh-toggle.on {
  background: linear-gradient(135deg, #0ea5e9, #2563eb);
}

.mesh-knob {
  position: absolute;
  width: 44rpx;
  height: 44rpx;
  top: 4rpx;
  left: 4rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

.mesh-toggle.on .mesh-knob {
  left: 48rpx;
}
